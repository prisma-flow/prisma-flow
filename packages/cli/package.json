{
  "name": "prisma-flow",
  "version": "0.3.3",
  "description": "Local-first Prisma migration visibility, drift detection, risk analysis, and deployment readiness",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/prisma-flow/prisma-flow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prisma-flow/prisma-flow.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/prisma-flow/prisma-flow/issues"
  },
  "keywords": ["prisma", "migrations", "database", "schema-drift", "cli", "dashboard", "devtools"],
  "files": ["dist", "public", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "prisma-flow": "./dist/index.js",
    "pf": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/copy-dashboard.mjs && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist public"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@prisma/internals": "^5.22.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.0",
    "hono": "^4.6.0",
    "open": "^11.0.1",
    "pino": "^10.3.1",
    "pino-pretty": "^11.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@prisma-flow/shared": "*",
    "@types/node": "^26.4.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  }
}
